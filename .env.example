# PDF OCR Toolkit 环境变量配置示例
# 复制此文件为 .env 并修改相应配置

# ========== OCR 后端选择 ==========
# 可选值: paddle, api
# paddle: 本地 PaddleOCR（需要安装 paddleocr）
# api: 远程 API 调用（需要配置 OCR_API_URL 和 OCR_API_TOKEN）
OCR_BACKEND=api

# ========== 输入输出路径 ==========
# 用于 --source=local 或 --source=mixed 模式

# 输入文件或目录（local 模式扫描的路径）
OCR_INPUT=./papers

# 输出目录（OCR 解析结果保存位置）
OCR_OUTPUT=./output

# ========== MongoDB 配置 ==========
# 用于 --source=mongo 或 --source=mixed 模式

# MongoDB 连接地址
MONGO_URI=mongodb://localhost:27017

# 数据库名称
MONGO_DB=acl_anthology

# 集合名称（存储论文元数据的表）
MONGO_COLLECTION=papers

# MongoDB 中存储 PDF 路径的字段名
MONGO_PATH_FIELD=pdf_file

# 本地 PDF 文件的根目录（用于与 MongoDB 中的相对路径拼接）
# 重要：这个路径应该与 MongoDB 中存储的相对路径的基准目录一致
# 例如：MongoDB 中存储为 "arxiv/2023/123.pdf"，则这里应该是 "/path/to/papers"
PDF_BASE_PATH=/path/to/your/papers

# ========== PaddleOCR 后端配置 ==========
# 仅当 OCR_BACKEND=paddle 时使用

# 公式识别后端类型（可选：vllm-server, none）
VL_REC_BACKEND=vllm-server

# VLLM 服务器地址
VL_REC_SERVER_URL=http://localhost:8118/v1

# VLLM 模型名称
VL_REC_API_MODEL_NAME=PaddleOCR-VL-1.5-0.9B

# ========== API 后端配置 ==========
# 仅当 OCR_BACKEND=api 时使用

# API 服务地址
OCR_API_URL=https://your-api-endpoint.com/layout-parsing

# API 访问令牌
OCR_API_TOKEN=your-api-token-here
