# 复制为 .env 后填写自己的配置

# ===== 输入 =====
# 批量扫描的根目录（例如 /data/papers），会递归查找下面所有 *.pdf
PDF_INPUT_DIR=/path/to/papers

# ===== OCR 模式 =====
# official = PaddleOCR 官方 API（默认）  local = 自己私有化部署的服务
OCR_MODE=official

# ===== 解析顺序 =====
# path  = 按扫描到的原始顺序（默认）
# pages = 先解析页数少的 PDF，再解析页数多的（会先用 pypdf 在本地数一遍页数）
PDF_ORDER=path

# ===== 输出 =====
# 结果文件夹名，建在「PDF 所在文件夹」的上一级目录里
OUTPUT_DIR_NAME=paddle_ocr_vl_1_6
# 结果 JSON 的固定文件名（不用 PDF 名 / 论文名）
OUTPUT_JSON_NAME=paddle_ocr_vl.json

# ===== 官方 API =====
# token 获取：打开 https://aistudio.baidu.com/paddleocr -> 点「API」-> 勾选「使用我的 AI Studio 访问令牌」
#            -> 点「复制代码」，代码里 TOKEN = "..." 就是它
# 注意：每个模型有当日解析页数上限（默认 20000 页/天，超了返回 429），单文件建议 100 页内（超出部分不解析）
PADDLEOCR_API_TOKEN=你的官方token
PADDLEOCR_MODEL=PaddleOCR-VL-1.6

# ===== 私有化部署（OCR_MODE=local 时生效）=====
LOCAL_API_URL=http://127.0.0.1:8080/layout-parsing
LOCAL_API_TOKEN=

# ===== 官方 API 轮询 =====
POLL_INTERVAL=5
POLL_TIMEOUT=3600
